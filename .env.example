# ==============================================================================
# AWS Data Platform - Environment Variables Template
# Copy this file to .env for local development (do NOT commit secrets to git)
# ==============================================================================

# AWS General Configuration
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012
ENVIRONMENT=dev

# Terraform Remote State Backend
TF_STATE_BUCKET=my-org-tf-state-dev
TF_STATE_DYNAMODB_TABLE=my-org-tf-locks-dev

# S3 Data Lake Buckets
S3_BRONZE_BUCKET=my-org-bronze-dev
S3_SILVER_BUCKET=my-org-silver-dev
S3_QUARANTINE_BUCKET=my-org-quarantine-dev
S3_ATHENA_RESULTS_BUCKET=my-org-athena-results-dev
S3_GLUE_SCRIPTS_BUCKET=my-org-glue-scripts-dev

# Orchestration & Ingestion
AIRFLOW_HOME=./airflow
AIRFLOW_UID=50000
AIRFLOW_IMAGE_NAME=apache/airflow:3.2.0
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow
_PIP_ADDITIONAL_REQUIREMENTS=
SQS_INGESTION_QUEUE_NAME=data-platform-ingestion-dev

# Snowflake Connection (Phase 9 Scaffolding)
SNOWFLAKE_ACCOUNT=org-account.region
SNOWFLAKE_USER=DATA_PLATFORM_SVC
SNOWFLAKE_ROLE=DATA_ENGINEER_ROLE
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=ANALYTICS_DEV
SNOWFLAKE_SCHEMA=PUBLIC
